{
  "name": "secure-mcp-gateway-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A sanitized TypeScript lab for security and resilience testing of an MCP gateway.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:all": "npm run check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
